<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Opaque base: same flat page background as the inactive tabs, so the accent tint
         above is a translucent overlay on a consistent surface rather than blending with
         whatever sits behind the tab row. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/backgroundColor" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Translucent accent tint, strong at the top fading down to 20% alpha at the tab's
         own bottom edge - the banner strip below (tab_banner_gradient.xml) picks up at
         that exact same 20% alpha and continues fading it out from there, so the two
         gradients read as one continuous fade instead of a seam. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/accentSoftStrongestColor"
                android:endColor="?attr/accentSoftStrongColor" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Accent border on top/left/right only: the shape's bottom edge is pushed outside
         the view's visible bounds via a negative inset, so its bottom stroke never
         renders and the tab blends into the content below with no seam. -->
    <item android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorPrimary" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
