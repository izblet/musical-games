<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fill: accent-tinted at the top, fading into the page/content background at the
         bottom, so the active tab visually flows into the content section below it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/accentSoftStrongColor"
                android:endColor="?attr/backgroundColor" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Accent border on top/left/right only: the shape's bottom edge is pushed outside
         the view's visible bounds via a negative inset, so its bottom stroke never
         renders and the tab blends into the content below with no seam. -->
    <item android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorPrimary" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
