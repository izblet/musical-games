<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Not editable/clickable right now (e.g. Game Parameters chips while not in edit mode) -
         no underline, since it'd otherwise imply the chip can be tapped. -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/surfaceChipColor"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/surfaceChipColor"/>
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorPrimary"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
