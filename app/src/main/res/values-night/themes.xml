<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MusicalGames" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- No other theme will be used -->

        <item name="backgroundColor">@color/light_gray</item>
        <item name="colorOnBackground">@color/white</item>

        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/dark_white</item>

        <item name="colorPrimaryVariant">@color/dark_blue</item>

        <item name="colorSecondary">@color/red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/dark_red</item>

        <item name="rightAnswerColor">@color/blue</item>
        <item name="wrongAnswerColor">@color/red</item>

        <item name="textFillColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>