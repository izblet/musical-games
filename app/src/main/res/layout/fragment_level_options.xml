<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/heading_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginTop="@dimen/screen_padding"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/item_bordered"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/levelTitleDescContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/label_gap_tight"
                    android:text="Level"
                    android:textColor="?attr/textTertiaryColor"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <EditText
                    android:id="@+id/levelTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:background="@drawable/underline_input_if_enabled"
                    android:inputType="textMultiLine"
                    android:textAlignment="viewStart"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <EditText
                    android:id="@+id/levelDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/underline_input_if_enabled"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/textSecondaryColor"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/temporaryLevelMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:textAlignment="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="New Level (Unsaved)" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/levelActionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/screen_padding"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/heading_container"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/saveLevelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Save Level" />

            <ImageButton
                android:id="@+id/editLevelInfoButton"
                android:layout_width="@dimen/icon_button_size_large"
                android:layout_height="@dimen/icon_button_size_large"
                android:padding="@dimen/icon_button_padding_small"
                android:background="@drawable/edit_toggle_background"
                android:scaleType="fitCenter"
                app:tint="@color/disableable_icon_tint"
                android:src="@drawable/ic_pencil" />

            <!-- ConstraintLayout (not FrameLayout): heartBinBlockOverlay below is 0dp, constrained to
                 heartBinButtonsRow's own edges rather than match_parent - ConstraintLayout specifically
                 resolves a 0dp child inside a wrap_content parent using the *other* children's natural
                 size, so this container's size always derives from the two buttons, no hardcoded size. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heartBinContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/heartBinButtonsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageButton
                        android:id="@+id/favouriteButton"
                        android:layout_width="@dimen/icon_button_size_large"
                        android:layout_height="@dimen/icon_button_size_large"
                        android:padding="@dimen/icon_button_padding_small"
                        android:background="?attr/pageBackgroundColor"
                        android:scaleType="centerInside"
                        app:tint="@color/disableable_icon_tint"
                        android:src="@drawable/ic_favourite_outline" />

                    <ImageButton
                        android:id="@+id/binButton"
                        android:layout_width="@dimen/icon_button_size_large"
                        android:layout_height="@dimen/icon_button_size_large"
                        android:padding="@dimen/icon_button_padding_small"
                        android:background="?attr/pageBackgroundColor"
                        android:scaleType="centerInside"
                        app:tint="@color/disableable_icon_tint"
                        android:src="@drawable/ic_bin" />

                </LinearLayout>

                <View
                    android:id="@+id/heartBinBlockOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/scrim"
                    app:layout_constraintTop_toTopOf="@id/heartBinButtonsRow"
                    app:layout_constraintBottom_toBottomOf="@id/heartBinButtonsRow"
                    app:layout_constraintStart_toStartOf="@id/heartBinButtonsRow"
                    app:layout_constraintEnd_toEndOf="@id/heartBinButtonsRow" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <Button
            android:id="@+id/startGameButton"
            style="@style/buttonFilledStyle"
            android:text="Start Game"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            app:layout_constraintTop_toBottomOf="@id/levelActionsRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
             />

        <LinearLayout
            android:id="@+id/gameplay_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/startGameButton" />

        <LinearLayout
            android:id="@+id/level_info_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/screen_padding"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gameplay_options_container">

            <LinearLayout
                android:id="@+id/level_info_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/item_bordered"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Game Parameters"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <ImageButton
                    android:id="@+id/editLevelButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:padding="@dimen/icon_button_padding"
                    android:background="@drawable/edit_toggle_background"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pencil" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/level_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/item_bordered"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp"
                android:layout_marginTop="8dp"
                />

        </LinearLayout>
        <View
            android:id="@+id/editBlockOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/scrim"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>
