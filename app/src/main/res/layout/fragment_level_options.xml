<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/heading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/item_bordered"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/levelTitleDescContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Level"
                android:textColor="?attr/tertiaryTextColor"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />

            <EditText
                android:id="@+id/levelTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/underline_input_if_enabled"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <EditText
                android:id="@+id/levelDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/underline_input_if_enabled"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/temporaryLevelMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="New Level (Unsaved)" />

        <Button
            android:id="@+id/saveLevelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Save Level" />

        <ImageButton
            android:id="@+id/editLevelInfoButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:background="@drawable/edit_toggle_background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pencil" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameplay_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heading_container" />

    <Button
        android:id="@+id/startGameButton"
        style="@style/buttonFilledStyle"
        android:text="Start Game"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/gameplay_options_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
         />

    <LinearLayout
        android:id="@+id/level_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startGameButton">

        <LinearLayout
            android:id="@+id/level_info_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/item_bordered"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Game Parameters"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <ImageButton
                android:id="@+id/editLevelButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:background="@drawable/edit_toggle_background"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pencil" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/level_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/item_bordered"
            android:paddingHorizontal="12dp"
            android:paddingVertical="14dp"
            android:layout_marginTop="8dp"
            />

    </LinearLayout>

    <View
        android:id="@+id/editBlockOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>