<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/surfaceHeaderColor"
        >


        <!-- Pause before the tab row starts; inherits contentContainer's surfaceHeaderColor. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- The top buttons -->
        <LinearLayout
            android:id="@+id/iconContainer"
            android:background="@drawable/tab_strip_background"
            android:layout_width="match_parent"
            android:layout_height="25pt"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Bookmark Buttons -->
            <ImageButton
                android:id="@+id/favouritesButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                app:tint="?attr/colorPrimary"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="6pt"
                app:backgroundTint="@null"
                android:src="@drawable/ic_heart" />

            <ImageButton
                android:id="@+id/levelsButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="6pt"
                app:tint="?attr/colorPrimary"
                app:backgroundTint="@null"
                android:src="@drawable/ic_levels" />

            <ImageButton
                android:id="@+id/customButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:tint="?attr/colorPrimary"
                android:padding="6pt"
                app:backgroundTint="@null"
                android:src="@drawable/ic_custom" />

            <ImageButton
                android:id="@+id/createButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="6pt"
                app:tint="?attr/colorPrimary"
                app:backgroundTint="@null"
                android:src="@drawable/ic_plus" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/contentFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/pageBackgroundColor">

            </FrameLayout>

            <!-- Banner with a gradient, sits above the frame layout-->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:background="@drawable/tab_banner_gradient" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
