<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/pageBackgroundColor"
    android:paddingVertical="@dimen/bottom_sheet_vertical_padding"
    >
    <com.example.musicalgames.utils.components.palettes.interval_palette.IntervalPaletteView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_marginVertical="@dimen/bottom_sheet_vertical_padding"
        android:layout_height="150dp"/>
    <androidx.appcompat.widget.AppCompatButton
        style="@style/buttonFilledStyle"
        android:id="@+id/confirm_button"
        android:text="Confirm"/>

</LinearLayout>