<resources>
    <dimen name="fab_margin">16dp</dimen>

    <!-- Minimum row height for customInputElementStyle's chip fields - also used as the real
         pixel height CustomGameCreator.kt needs for its programmatically-built TableRow cells,
         since customInputElementStyle's own layout_height is wrap_content (with this as a
         minHeight floor) and TableRow can't size itself from that at runtime. -->
    <dimen name="custom_creator_row_height">44dp</dimen>

    <!-- Shared between customLabelStyle/customInputStyle (XML rows, Play By Ear only) and
         CustomGameCreator.kt's styleLabel()/styleSelector() (programmatic TableRow, every other
         game) so both row-building paths align identically. -->
    <dimen name="custom_creator_label_width">96dp</dimen>
    <dimen name="custom_creator_label_margin">12dp</dimen>
    <dimen name="custom_creator_chip_gap">10dp</dimen>
    <dimen name="custom_creator_row_gap">13dp</dimen>

    <!-- customInputElementStyle's own chip padding, reused by CustomGameCreator.kt's
         styleSelector() since some selectors (KeyboardSelector/IntervalSelector/
         MultiEnumSpinner) never get that style applied through their own construction. -->
    <dimen name="custom_creator_chip_padding_horizontal">11dp</dimen>
    <dimen name="custom_creator_chip_padding_end">32dp</dimen>
    <dimen name="custom_creator_chip_padding_vertical">10dp</dimen>

    <!-- The "Selection" piano/interval-preview chip draws its own content edge-to-edge and
         needs to nearly fill the chip - unlike text chips, which need room for the label plus
         (formerly) a caret, this is just enough to reveal a sliver of chip background/underline
         around it. -->
    <dimen name="custom_creator_preview_chip_padding">1.5dp</dimen>
</resources>