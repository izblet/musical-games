<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar chrome: header surface background, near-white title, turquoise overflow/menu icons. -->
    <style name="ThemeOverlay.MusicalGames.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">?attr/colorOnBackground</item>
        <item name="colorControlNormal">?attr/colorPrimary</item>
    </style>

    <!-- Fixed-width row label to the left of a chip field, matching the mockups' 96dp label
         column - not textEnd/fill-width, which is what made TableLayout's cross-row column
         matching stretch these unpredictably. -->
    <style name="customLabelStyle">
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">?attr/textSecondaryColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">@dimen/custom_creator_label_width</item>
        <item name="android:layout_marginEnd">@dimen/custom_creator_label_margin</item>
    </style>
    <!-- Chip field to the right of a customLabelStyle label. layout_height is a fixed row
         height, not wrap_content, so every chip in a row - including the "Selection"
         piano/interval-preview chips, whose internal content has no intrinsic size of its
         own - resolves to the exact same height. This matches CustomGameCreator.kt's
         programmatic TableRow path, which has always given its cells a fixed pixel height
         (see inputElementHeight there) rather than wrap_content. paddingEnd leaves room for
         spinner_chip_background's composited caret glyph. -->
    <style name="customInputElementStyle">
        <item name="android:background">@drawable/spinner_chip_background</item>
        <item name="android:popupBackground">@drawable/spinner_popup_background</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/editable_row_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">@dimen/custom_creator_chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/custom_creator_chip_padding_end</item>
        <item name="android:paddingTop">@dimen/custom_creator_chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/custom_creator_chip_padding_vertical</item>
    </style>
    <!-- Same chip as customInputElementStyle, but for the "Selection" piano/interval-preview
         chip (KeyboardSelector/IntervalSelector), which draws its own content and should nearly
         fill the chip rather than leave room for a text label. -->
    <style name="previewSelectorChipStyle" parent="customInputElementStyle">
        <item name="android:paddingStart">@dimen/custom_creator_preview_chip_padding</item>
        <item name="android:paddingEnd">@dimen/custom_creator_preview_chip_padding</item>
        <item name="android:paddingTop">@dimen/custom_creator_preview_chip_padding</item>
        <item name="android:paddingBottom">@dimen/custom_creator_preview_chip_padding</item>
    </style>
    <!-- Wraps 2 chips sharing one row slot (e.g. min sound note+octave); gap between them is a
         marginStart on the second chip, matching the mockups' 10dp inter-chip gap. -->
    <style name="customInputStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <!-- Ghost button: transparent, turquoise text (e.g. "Save"). -->
    <style name="buttonGhostStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Filled button: solid turquoise, dark text (e.g. "Play"/"Start Game"). -->
    <style name="buttonFilledStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">@dimen/text_component_padding_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:background">@drawable/button_basic</item>
    </style>

    <!-- Outlined button: turquoise stroke, sharp corners (e.g. "Reset all to defaults"). -->
    <style name="buttonOutlinedStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:paddingVertical">11dp</item>
    </style>
</resources>