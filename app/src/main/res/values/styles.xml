<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar chrome: header surface background, near-white title, turquoise overflow/menu icons. -->
    <style name="ThemeOverlay.MusicalGames.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">?attr/colorOnBackground</item>
        <item name="colorControlNormal">?attr/colorPrimary</item>
    </style>

    <!-- Fixed-width row label to the left of a chip field, matching the mockups' 96dp label
         column - not textEnd/fill-width, which is what made TableLayout's cross-row column
         matching stretch these unpredictably. -->
    <style name="customLabelStyle">
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">?attr/secondaryTextColor</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">@dimen/custom_creator_label_width</item>
        <item name="android:layout_marginEnd">@dimen/custom_creator_label_margin</item>
    </style>
    <!-- Chip field to the right of a customLabelStyle label. layout_height is wrap_content with
         a minHeight floor (not a fixed height) so plain text chips size to their content while
         the "Selection" piano/interval-preview chips - whose internal content has no intrinsic
         size at all - don't collapse to 0: FrameLayout runs a second measurement pass for
         MATCH_PARENT children once minHeight establishes its own floor, so this one attribute
         fixes both cases without special-casing either. paddingEnd leaves room for
         spinner_chip_background's composited caret glyph. -->
    <style name="customInputElementStyle">
        <item name="android:background">@drawable/spinner_chip_background</item>
        <item name="android:popupBackground">@drawable/spinner_popup_background</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/custom_creator_row_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <!-- Wraps 2 chips sharing one row slot (e.g. min sound note+octave); gap between them is a
         marginStart on the second chip, matching the mockups' 10dp inter-chip gap. -->
    <style name="customInputStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <!-- Superseded by buttonGhostStyle/buttonFilledStyle/buttonOutlinedStyle; kept until all
         consumers are migrated, then removed in the leftover-cleanup pass. -->
    <style name="basicListButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/textFillColor</item>
        <item name="android:background">@drawable/button_basic</item>
    </style>

    <!-- Ghost button: transparent, turquoise text (e.g. "Save"). -->
    <style name="buttonGhostStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Filled button: solid turquoise, dark text (e.g. "Play"/"Start Game"). -->
    <style name="buttonFilledStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:background">@drawable/button_basic</item>
    </style>

    <!-- Outlined button: turquoise stroke, sharp corners (e.g. "Reset all to defaults"). -->
    <style name="buttonOutlinedStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:paddingVertical">11dp</item>
    </style>
</resources>